# Repository-safe example environment variables
# Copy this to `.env` (or `.env.local`) and fill in real values locally.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require&channel_binding=require"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Email Configuration
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=465
EMAIL_USER="your-email@example.com"
EMAIL_APP_PASSWORD="your-email-app-password"
EMAIL_FROM="Your Company <noreply@example.com>"
COMPANY_EMAIL="company@example.com"

# NextAuth
NEXTAUTH_SECRET="generate-a-strong-random-string-here"
NEXTAUTH_URL="https://your-domain.com"

# MongoDB (optional)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/DBNAME?retryWrites=true&w=majority"

# Optional: Twilio WhatsApp (server-side send)
# If set, contact submissions will be forwarded to WhatsApp via Twilio
TWILIO_ACCOUNT_SID='AC9d4e2c50b64ddb1094c2a2ea3a23f799
TWILIO_AUTH_TOKEN="5d8a2388fac4307e1656fb9dc28dc23f"
TWILIO_WHATSAPP_FROM="whatsapp:+1415XXXXXXX"
TWILIO_WHATSAPP_TO="whatsapp:+919753089649"

# Quick contact helpers (example)
WHATSAPP_NUMBER=+919753089649
# COMPANY_EMAIL already present above; set to your support mailbox
